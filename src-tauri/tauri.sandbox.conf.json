{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "InstaDesk Sandbox",
  "mainBinaryName": "InstaDesk-Sandbox",
  "identifier": "com.fcxestudios.instadesk.sandbox",
  "app": {
    "windows": [
      {
        "title": "InstaDesk — SANDBOX",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/sandbox/32x32.png",
      "icons/sandbox/128x128.png",
      "icons/sandbox/128x128@2x.png",
      "icons/sandbox/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/FCCXE/InstaDesk-V2.0/releases/download/sandbox-channel/latest.json"
      ]
    }
  }
}
